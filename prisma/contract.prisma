  model FinancialThreshold {
    id                         String            @id(map: "financial_threshold_pkey") @onCreate(uuid(7))
    thresholdName              String            @unique(map: "financial_threshold_thresholdName_key")
    label                      String
    description                Text?
    amount                     Int
    currency                   pg.enum(Currency) @default("USD")
    whoCanOverride             String[]
    requiredPermissionOverride String
    minRoleLevelOverride       Int
    triggersAlert              Boolean           @default(true)
    alertRecipients            String[]
    createdAt                  DateTime          @default(now())
    updatedAt                  DateTime          @onCreate(now()) @onUpdate(now())

    @@rls
    @@map("financial_threshold")
  }

  model TaxClass {
    id          String    @id(map: "tax_classes_pkey") @onCreate(uuid(7))
    name        String    @unique(map: "tax_classes_name_key")
    description Text?

    products Product[]  @relation(name: "product_tax_classes")
    taxRates TaxRate[]  @relation(name: "tax_class_rates")

    @@rls
    @@map("tax_classes")
  }

  model TaxRate {
    id         Uuid                   @id(map: "tax_rate_pkey") @onCreate(uuid(7))
    taxClassId String
    country    String                 @default("RDC")
    region     String?
    rate       Decimal(precision: 5, scale: 4)

    taxClass TaxClass @relation(name: "tax_class_rates", fields: [taxClassId], references: [id], onDelete: Cascade, map: "tax_rate_taxClassId_fkey")

    @@unique([taxClassId, country, region], map: "tax_rate_taxClassId_country_region_key")
    @@index([taxClassId], name: "tax_rate_taxClassId_idx")
    @@index([country, region], name: "tax_rate_country_region_idx")
    @@index([country, region, taxClassId], name: "tax_rate_country_region_taxClassId_idx")
    @@rls
    @@map("tax_rate")
  }

  model SeoRedirect {
    id         String   @id(map: "seo_redirects_pkey") @onCreate(uuid(7))
    fromPath   String   @unique(map: "seo_redirects_fromPath_key")
    toPath     String
    statusCode Int      @default(301)
    createdAt  DateTime @default(now())

    @@rls
    @@map("seo_redirects")
  }

  model AppConfig {
    id                    String             @id(map: "app_config_pkey") @onCreate(uuid(7))
    usdToCdfRate          Decimal(precision: 12, scale: 4)
    exchangeRateSource    String
    exchangeRateUpdatedAt DateTime?
    createdAt             DateTime           @default(now())
    updatedAt             DateTime           @onCreate(now()) @onUpdate(now())

    @@rls
    @@map("app_config")
  }

  model ExchangeRate {
    id            String             @id(map: "exchange_rate_pkey") @onCreate(uuid(7))
    baseCurrency  pg.enum(Currency)
    quoteCurrency pg.enum(Currency)
    rate          Decimal(precision: 18, scale: 6)
    source        String
    effectiveAt   DateTime
    createdAt     DateTime           @default(now())

    @@unique([baseCurrency, quoteCurrency, effectiveAt], map: "exchange_rate_base_quote_effective_key")
    @@index([baseCurrency, quoteCurrency], name: "exchange_rate_base_quote_idx")
    @@index([effectiveAt], name: "exchange_rate_effectiveAt_idx")
    @@rls
    @@map("exchange_rate")
  }

  model NewsletterSubscriber {
    id        String            @id(map: "newsletter_subscriber_pkey") @onCreate(uuid(7))
    email     String            @unique(map: "newsletter_subscriber_email_key")
    createdAt TimestamptzJsDate(6) @onCreate(now())
    updatedAt TimestamptzJsDate(6) @onCreate(now()) @onUpdate(now())

    @@rls
    @@map("newsletter_subscriber")
  }

  model SystemConfiguration {
    id        String   @id(map: "system_configuration_pkey") @onCreate(uuid(7))
    key       String   @unique(map: "system_configuration_key_key")
    value     String
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@rls
    @@map("system_configuration")
  }

  model DeletedAccountRegistry {
    id            String   @id(map: "deleted_account_registry_pkey") @onCreate(uuid(7))
    version       Int      @default(1)
    userId        String
    userEmail     String
    userName      String?
    deletedBy     Uuid?
    deletedByRole String
    userSnapshot  Jsonb
    reason        String
    metadata      Json?
    createdAt     DateTime @default(now())
    restoredAt    DateTime?
    restoredBy    Uuid?
    restoreNote   Text?

    deletedByUser User? @relation(name: "deleted_account_by", fields: [deletedBy], references: [id], onDelete: SetNull, map: "deleted_account_registry_deletedBy_fkey")
    restoredByUser User? @relation(name: "deleted_account_restored_by", fields: [restoredBy], references: [id], onDelete: SetNull, map: "deleted_account_registry_restoredBy_fkey")

    @@index([userId], name: "deleted_account_registry_userId_idx")
    @@index([deletedBy], name: "deleted_account_registry_deletedBy_idx")
    @@index([createdAt], name: "deleted_account_registry_createdAt_idx")
    @@index([userEmail], name: "deleted_account_registry_userEmail_idx")
    @@rls
    @@map("deleted_account_registry")
  }

  model Notification {
    id        Uuid     @id(map: "notification_pkey") @onCreate(uuid(7))
    userId    Uuid
    type      String
    title     String
    message   Text
    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "notification_userId_fkey")

    @@index([userId, createdAt], name: "notification_userId_createdAt_idx")
    @@rls
    @@map("notification")
  }

  model SearchAnalytics {
    id        Uuid     @id(map: "search_analytics_pkey") @onCreate(uuid(7))
    userId    Uuid?    @unique(map: "search_analytics_userId_key")
    searches  Json?
    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    user User? @relation(fields: [userId], references: [id], onDelete: Cascade, map: "search_analytics_userId_fkey")

    @@rls
    @@map("search_analytics")
  }

  model Dashboard {
    id        Uuid     @id(map: "dashboard_pkey") @onCreate(uuid(7))
    name      String
    userId    Uuid
    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "dashboard_userId_fkey")

    @@rls
    @@map("dashboard")
  }

  // ==========================================
  // Ãƒâ€°NUMÃƒâ€°RATIONS NATIVES (PostgreSQL)
  // ==========================================
  native_enum UserStatus {
    ACTIVE = "ACTIVE"
    SUSPENDED = "SUSPENDED"
    ARCHIVED = "ARCHIVED"
  }

  native_enum Role {
    SUPER_ADMIN = "SUPER_ADMIN"
    ADMIN = "ADMIN"
    MANAGER = "MANAGER"
    SUPERVISOR = "SUPERVISOR"
    TEAM_LEADER = "TEAM_LEADER"
    AGENT = "AGENT"
    USER = "USER"
    GUEST = "GUEST"
  }

  native_enum VerificationType {
    EMAIL_VERIFICATION = "EMAIL_VERIFICATION"
    PASSWORD_RESET = "PASSWORD_RESET"
    MAGIC_LINK = "MAGIC_LINK"
    EMAIL_CHANGE = "EMAIL_CHANGE"
    PHONE_VERIFICATION = "PHONE_VERIFICATION"
    TWO_FACTOR = "TWO_FACTOR"
  }

  native_enum AuditSeverity {
    INFO = "INFO"
    WARNING = "WARNING"
    CRITICAL = "CRITICAL"
  }

  native_enum ProductStatus {
    DRAFT = "DRAFT"
    PENDING = "PENDING"
    SCHEDULED = "SCHEDULED"
    PUBLISHED = "PUBLISHED"
    ARCHIVED = "ARCHIVED"
    DISCONTINUED = "DISCONTINUED"
  }

  native_enum Currency {
    USD = "USD"
    CDF = "CDF"
  }

  native_enum StockMovementType {
    IN = "IN"
    OUT = "OUT"
    ADJUSTMENT = "ADJUSTMENT"
    RESERVATION = "RESERVATION"
    RELEASE = "RELEASE"
    RETURN = "RETURN"
  }

  native_enum TransactionType {
    RESTOCK = "RESTOCK"
    SALE = "SALE"
    RETURN = "RETURN"
    SHRINKAGE = "SHRINKAGE"
  }

  native_enum OrderStatusEnum {
    PENDING = "PENDING"
    CONFIRMED = "CONFIRMED"
    PROCESSING = "PROCESSING"
    SHIPPED = "SHIPPED"
    DELIVERED = "DELIVERED"
    CANCELLED = "CANCELLED"
    REFUNDED = "REFUNDED"
  }

  native_enum ShipmentStatus {
    PENDING = "PENDING"
    SHIPPED = "SHIPPED"
    IN_TRANSIT = "IN_TRANSIT"
    DELIVERED = "DELIVERED"
    EXCEPTION = "EXCEPTION"
  }

  native_enum PaymentStatus {
    PENDING = "PENDING"
    COMPLETED = "COMPLETED"
    FAILED = "FAILED"
    REFUNDED = "REFUNDED"
  }

  native_enum PaymentMethodType {
    CINETPAY = "CINETPAY"
    MPESA = "MPESA"
    ORANGE_MONEY = "ORANGE_MONEY"
    AIRTEL_MONEY = "AIRTEL_MONEY"
    CASH_ON_DELIVERY = "CASH_ON_DELIVERY"
  }

  native_enum PaymentAuditStatus {
    PENDING = "PENDING"
    SUCCESS = "SUCCESS"
    FAILED = "FAILED"
    REPLAY_ATTEMPT_BLOCKED = "REPLAY_ATTEMPT_BLOCKED"
    AMOUNT_MISMATCH = "AMOUNT_MISMATCH"
  }

  native_enum IdempotencyStatus {
    PENDING = "PENDING"
    COMPLETED = "COMPLETED"
    FAILED = "FAILED"
  }

  native_enum ReturnStatus {
    REQUESTED = "REQUESTED"
    APPROVED = "APPROVED"
    REJECTED = "REJECTED"
    RECEIVED = "RECEIVED"
    REFUNDED = "REFUNDED"
  }

  native_enum RefundStatus {
    PENDING = "PENDING"
    COMPLETED = "COMPLETED"
    FAILED = "FAILED"
  }

  native_enum DiscountType {
    PERCENTAGE = "PERCENTAGE"
    FIXED_AMOUNT = "FIXED_AMOUNT"
  }

  native_enum SupplierType {
    LOCAL = "LOCAL"
    INTERNATIONAL = "INTERNATIONAL"
  }

  policy_select posts_public_read {
    target = Post
    roles  = [anon, authenticated]
    using  = sql`true`
  }

}
