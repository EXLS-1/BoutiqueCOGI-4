    country   String   @default("RDC")
    phone     String
    createdAt DateTime @default(now())

    order Order @relation(name: "order_addresses", fields: [orderId], references: [id], onDelete: Cascade, map: "order_address_orderId_fkey")

    @@index([orderId], name: "order_address_orderId_idx")
    @@rls
    @@map("order_address")
  }

  model OrderStatus {
