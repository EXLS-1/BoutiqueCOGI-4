    whoCanCreate             String[]
    whoCanEdit               String[]
    whoCanDelete             String[]
    requiredPermissionCreate String
    requiredPermissionEdit   String
    requiredPermissionDelete String
    minRoleLevelCreate       Int
    minRoleLevelEdit         Int
    minRoleLevelDelete       Int
    maxVariants              Int
    requiresApproval         Boolean  @default(false)
    isDefault                Boolean  @default(false)
    isActive                 Boolean  @default(true)
    createdAt                DateTime @default(now())
    updatedAt                DateTime @onCreate(now()) @onUpdate(now())

    products Product[] @relation(name: "product_type_products")

    @@index([type], name: "product_type_config_type_idx")
    @@rls
    @@map("product_type_config")
  }

  model ProductView {
    id        Uuid     @id(map: "product_views_pkey") @onCreate(uuid(7))
    productId String
    sessionId String?
    userId    Uuid?
    viewedAt  DateTime @default(now())

    product Product @relation(name: "product_views", fields: [productId], references: [id], onDelete: Cascade, map: "product_views_productId_fkey")
    user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull, map: "product_views_userId_fkey")

    @@index([productId, viewedAt], name: "product_views_productId_viewedAt_idx")
    @@rls
    @@map("product_views")
  }

  model VariantAttributeConfig {
    id              Uuid     @id(map: "variant_attribute_config_pkey") @onCreate(uuid(7))
    attribute       String   @unique(map: "variant_attribute_config_attribute_key")
    label           String
    type            String
    isRequired      Boolean  @default(false)
    whoCanConfigure String[]
    minRoleLevel    Int
    createdAt       DateTime @default(now())
    updatedAt       DateTime @onCreate(now()) @onUpdate(now())

    @@index([attribute], name: "variant_attribute_config_attribute_idx")
    @@rls
    @@map("variant_attribute_config")
  }

  // ==========================================
  // INVENTAIRE & STOCK
  // ==========================================
  model Stock {
    id             Uuid            @id(map: "stocks_pkey") @onCreate(uuid(7))
    productId      String          @unique(map: "stocks_productId_key")
    quantity       Int             @default(0)
    reserved       Int             @default(0)
    alertThreshold Int             @default(10)
    warehouse      String?
    lastMovementAt DateTime        @default(now())
    updatedAt      DateTime        @onCreate(now()) @onUpdate(now())
    updatedBy      Uuid?

    product   Product         @relation(name: "product_stock", fields: [productId], references: [id], onDelete: Cascade, map: "stocks_productId_fkey")
    updater   User?           @relation(name: "stock_updater", fields: [updatedBy], references: [id], onDelete: SetNull, map: "stocks_updatedBy_fkey")
    movements StockMovement[] @relation(name: "stock_movements")

    @@index([productId], name: "stocks_productId_idx")
    @@index([quantity], name: "stocks_quantity_idx")
    @@index([warehouse], name: "stocks_warehouse_idx")
    @@rls
    @@map("stocks")
  }

  model VariantStock {
    id             Uuid           @id(map: "variant_stock_pkey") @onCreate(uuid(7))
    variantId      Uuid
    warehouseId    String?
    quantity       Int            @default(0)
    reserved       Int            @default(0)
    alertThreshold Int            @default(10)
    lastMovementAt DateTime       @default(now())
    updatedBy      Uuid?
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @onCreate(now()) @onUpdate(now())

    variant   ProductVariant  @relation(name: "variant_stocks", fields: [variantId], references: [id], onDelete: Cascade, map: "variant_stock_variantId_fkey")
    warehouse Warehouse?      @relation(name: "warehouse_variant_stocks", fields: [warehouseId], references: [id], onDelete: SetNull, map: "variant_stock_warehouseId_fkey")
    updater   User?           @relation(name: "variant_stock_updater", fields: [updatedBy], references: [id], onDelete: SetNull, map: "variant_stock_updatedBy_fkey")
    movements StockMovement[] @relation(name: "variant_stock_movements")

    @@unique([variantId, warehouseId], map: "variant_stock_variantId_warehouseId_key")
    @@index([variantId], name: "variant_stock_variantId_idx")
    @@index([warehouseId], name: "variant_stock_warehouseId_idx")
    @@rls
    @@map("variant_stock")
  }

  model StockMovement {
    id             Uuid                  @id(map: "stock_movements_pkey") @onCreate(uuid(7))
    stockId        Uuid
    type           pg.enum(StockMovementType)
    quantity       Int
    delta          Int
    reason         String?
    orderId        Uuid?
    userId         Uuid?
    variantStockId Uuid?
    createdAt      DateTime              @default(now())

    stock        Stock         @relation(name: "stock_movements", fields: [stockId], references: [id], onDelete: Cascade, map: "stock_movements_stockId_fkey")
    variantStock VariantStock? @relation(name: "variant_stock_movements", fields: [variantStockId], references: [id], onDelete: SetNull, map: "stock_movements_variantStockId_fkey")
    user         User?         @relation(name: "stock_movement_user", fields: [userId], references: [id], onDelete: SetNull, map: "stock_movements_userId_fkey")
    order        Order?        @relation(name: "order_stock_movements", fields: [orderId], references: [id], onDelete: SetNull, map: "stock_movements_orderId_fkey")

    @@index([stockId], name: "stock_movements_stockId_idx")
    @@index([variantStockId], name: "stock_movements_variantStockId_idx")
    @@index([type], name: "stock_movements_type_idx")
    @@index([orderId], name: "stock_movements_orderId_idx")
    @@index([createdAt], name: "stock_movements_createdAt_idx")
    @@rls
    @@map("stock_movements")
  }

  model InventoryTransaction {
    id              Uuid             @id(map: "inventory_transaction_pkey") @onCreate(uuid(7))
    productId       String
    variantId       Uuid?
    quantity        Int
    reason          pg.enum(TransactionType)
    referenceId     String?
    warehouseId     String?
    performedBy     Uuid?
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @onCreate(now()) @onUpdate(now())

    product         Product          @relation(name: "inventory_ledger", fields: [productId], references: [id], onDelete: Restrict, map: "inventory_transaction_productId_fkey")
    variant         ProductVariant?  @relation(name: "variant_inventory_tx", fields: [variantId], references: [id], onDelete: Restrict, map: "inventory_transaction_variantId_fkey")
    performedByUser User?            @relation(name: "inventory_tx_user", fields: [performedBy], references: [id], onDelete: SetNull, map: "inventory_transaction_performedBy_fkey")

    @@index([productId, variantId, createdAt], name: "inventory_transaction_product_variant_createdAt_idx")
    @@rls
    @@map("inventory_transaction")
  }

  model InventorySnapshot {
    id          Uuid            @id(map: "inventory_snapshot_pkey") @onCreate(uuid(7))
    productId   String
    variantId   Uuid?
    available   Int             @default(0)
    reserved    Int             @default(0)
    warehouseId String?
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @onCreate(now()) @onUpdate(now())

    product Product         @relation(name: "inventory_snapshots", fields: [productId], references: [id], onDelete: Cascade, map: "inventory_snapshot_productId_fkey")
    variant ProductVariant? @relation(name: "variant_inventory_snapshots", fields: [variantId], references: [id], map: "inventory_snapshot_variantId_fkey")

    @@unique([productId, variantId], map: "inventory_snapshot_productId_variantId_key")
    @@index([productId], name: "inventory_snapshot_productId_idx")
    @@index([createdAt], name: "inventory_snapshot_createdAt_idx")
    @@rls
    @@map("inventory_snapshot")
  }

  model Warehouse {
    id             String          @id(map: "warehouse_pkey") @onCreate(uuid(7))
    name           String
    location       String
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @onCreate(now()) @onUpdate(now())

    purchaseOrders PurchaseOrder[] @relation(name: "warehouse_purchase_orders")
    variantStocks  VariantStock[]  @relation(name: "warehouse_variant_stocks")

    @@rls
    @@map("warehouse")
  }

  model Supplier {
    id             String               @id(map: "supplier_pkey") @onCreate(uuid(7))
    name           String
    contact        String?
    type           pg.enum(SupplierType) @default("LOCAL")
    createdAt      DateTime             @default(now())
    updatedAt      DateTime             @onCreate(now()) @onUpdate(now())

    purchaseOrders PurchaseOrder[] @relation(name: "supplier_purchase_orders")

    @@rls
    @@map("supplier")
  }

  model PurchaseOrder {
    id          Uuid      @id(map: "purchase_order_pkey") @onCreate(uuid(7))
    supplierId  String
    warehouseId String
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @onCreate(now()) @onUpdate(now())

    supplier  Supplier  @relation(name: "supplier_purchase_orders", fields: [supplierId], references: [id], onDelete: Cascade, map: "purchase_order_supplierId_fkey")
    warehouse Warehouse @relation(name: "warehouse_purchase_orders", fields: [warehouseId], references: [id], onDelete: Cascade, map: "purchase_order_warehouseId_fkey")

    @@index([supplierId, warehouseId], name: "purchase_order_supplierId_warehouseId_idx")
    @@rls
    @@map("purchase_order")
  }

  // ==========================================
  // COMMERCE (PANIER, COMMANDE, PAIEMENT)
  // ==========================================
  model Cart {
    id           Uuid      @id(map: "cart_pkey") @onCreate(uuid(7))
    userId       Uuid?     @unique(map: "cart_userId_key")
    sessionToken String?   @unique(map: "cart_sessionToken_key")
    expiresAt    DateTime
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @onCreate(now()) @onUpdate(now())

    user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "cart_userId_fkey")
    items          CartItem[]      @relation(name: "cart_items")
    abandonedCarts AbandonedCart[] @relation(name: "cart_abandoned")

    @@index([expiresAt], name: "cart_expiresAt_idx")
    @@rls
    @@map("cart")
  }

  model CartItem {
    id                 Uuid                     @id(map: "cart_item_pkey") @onCreate(uuid(7))
    cartId             Uuid
    variantId          Uuid
    quantity           Int                      @default(1)
    snapshotPriceAtAdd Json?
    createdAt          DateTime                 @default(now())
    updatedAt          DateTime                 @onCreate(now()) @onUpdate(now())

    cart    Cart           @relation(name: "cart_items", fields: [cartId], references: [id], onDelete: Cascade, map: "cart_item_cartId_fkey")
    variant ProductVariant @relation(name: "cart_items", fields: [variantId], references: [id], onDelete: Cascade, map: "cart_item_variantId_fkey")

    @@unique([cartId, variantId], map: "cart_item_cartId_variantId_key")
    @@index([cartId], name: "cart_item_cartId_idx")
    @@rls
    @@map("cart_item")
  }

  model AbandonedCart {
    id        Uuid     @id(map: "abandoned_cart_pkey") @onCreate(uuid(7))
    cartId    Uuid     @unique(map: "abandoned_cart_cartId_key")
    userId    Uuid?
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    cart Cart @relation(name: "cart_abandoned", fields: [cartId], references: [id], onDelete: Cascade, map: "abandoned_cart_cartId_fkey")
    user User? @relation(fields: [userId], references: [id], onDelete: SetNull, map: "abandoned_cart_userId_fkey")

    @@rls
    @@map("abandoned_cart")
  }

  model Order {
    id               Uuid                     @id(map: "order_pkey") @onCreate(uuid(7))
    orderNumber      String                   @unique(map: "order_orderNumber_key")
    userId           Uuid?
    status           pg.enum(OrderStatusEnum) @default("PENDING")
    subtotalAmount   Int
    taxAmount        Int
    discountAmount   Int
    grandTotal       Int
    shippingCost     Int                      @default(0)
    totalAmount      Int
    currency         pg.enum(Currency)        @default("USD")
    billingMethodId  String?
    shippingMethodId String?
    trackingNumber   String?
    cinetpayTransId  String?                  @unique(map: "order_cinetpayTransId_key")
    createdAt        DateTime                 @default(now())
    updatedAt        DateTime                 @onCreate(now()) @onUpdate(now())
    paidAt           DateTime?
    couponId         String?

    user                 User?                @relation(fields: [userId], references: [id], onDelete: SetNull, map: "order_userId_fkey")
    billingMethod        BillingMethod?       @relation(name: "order_billing_methods", fields: [billingMethodId], references: [id], map: "order_billingMethodId_fkey")
    shippingMethod       ShippingMethod?      @relation(name: "order_shipping_methods", fields: [shippingMethodId], references: [id], map: "order_shippingMethodId_fkey")
    items                OrderItem[]          @relation(name: "order_items")
    payment              Payment?             @relation(name: "order_payment")
    shipment             Shipment?            @relation(name: "order_shipment")
    statusHistories      OrderStatusHistory[] @relation(name: "order_status_histories")
    couponUsage          CouponUsage?         @relation(name: "order_coupon_usage")
    giftCardRedemptions  GiftCardRedemption[] @relation(name: "order_gift_card_redemptions")
    returns              Return[]             @relation(name: "order_returns")
    refundItems          RefundItem[]         @relation(name: "order_refund_items")
    orderAddresses       OrderAddress[]       @relation(name: "order_addresses")
    stockReservations    StockReservation[]   @relation(name: "order_stock_reservations")
    stockMovements       StockMovement[]      @relation(name: "order_stock_movements")
    invoice              Invoice?             @relation(name: "order_invoice")
    coupon               Coupon?              @relation(name: "coupon_orders", fields: [couponId], references: [id], map: "order_couponId_fkey")

    @@index([userId, createdAt], name: "order_userId_createdAt_idx")
    @@index([status, createdAt], name: "order_status_createdAt_idx")
    @@rls
    @@map("order")
  }

  model OrderItem {
    id             Uuid                @id(map: "order_item_pkey") @onCreate(uuid(7))
    orderId        Uuid
    productId      String
    variantId      Uuid
    productName    String
    variantSku     String
    productImage   String?
    attributes     Json?
    quantity       Int
    unitPrice      Int
    subtotal       Int
    taxAmount      Int?
    discountAmount Int?
    currency       pg.enum(Currency)?
    exchangeRate   Decimal(precision: 10, scale: 4)?

    order   Order          @relation(name: "order_items", fields: [orderId], references: [id], onDelete: Cascade, map: "order_item_orderId_fkey")
    product Product        @relation(name: "order_items", fields: [productId], references: [id], onDelete: Restrict, map: "order_item_productId_fkey")
    variant ProductVariant @relation(name: "order_item_variants", fields: [variantId], references: [id], onDelete: Restrict, map: "order_item_variantId_fkey")
    returnItems ReturnItem[] @relation(name: "order_item_returns")

    @@index([orderId], name: "order_item_orderId_idx")
    @@rls
    @@map("order_item")
  }

  model OrderStatusHistory {
    id            Uuid           @id(map: "order_status_history_pkey") @onCreate(uuid(7))
    orderId       Uuid
    orderStatusId String
    note          Text?
    createdAt     DateTime       @default(now())

    order       Order       @relation(name: "order_status_histories", fields: [orderId], references: [id], onDelete: Cascade, map: "order_status_history_orderId_fkey")
    orderStatus OrderStatus @relation(name: "order_status_histories_ref", fields: [orderStatusId], references: [id], map: "order_status_history_orderStatusId_fkey")

    @@index([orderId, createdAt], name: "order_status_history_orderId_createdAt_idx")
    @@rls
    @@map("order_status_history")
  }

  model OrderAddress {
    id        Uuid     @id(map: "order_address_pkey") @onCreate(uuid(7))
