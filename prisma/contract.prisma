    productId      String
    currency       String                   @default("USD")
    amount         Decimal
    compareAtPrice Int?
    country        String?
    region         String?
    startsAt       DateTime?
    endsAt         DateTime?

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "product_price_productId_fkey")

    @@index([productId, startsAt, endsAt], name: "product_price_productId_dates_idx")
    @@index([country, region], name: "product_price_country_region_idx")
    @@rls
    @@map("product_price")
  }

  model ProductTypeConfig {
    id                       String   @id(map: "product_type_config_pkey") @onCreate(uuid(7))
    type                     String   @unique(map: "product_type_config_type_key")
    label                    String
