// use prisma-8

namespace extensions {
  extension pg_stat_statements {}
  extension pgcrypto {}
  extension uuid-ossp {}
}

namespace public {

  // ==========================================
  // AUTHENTIFICATION & SESSIONS
  // ==========================================
  
  model Post {
    id        Uuid     @id(map: "post_pkey") @onCreate(uuid(7))
    title     String
    userId    Uuid     @map("author_id")
    content   Text?
    published Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "post_userId_fkey")

    @@rls
    @@map("posts")
  }
  
  model User {
    id                Uuid                @id(map: "user_pkey") @onCreate(uuid(7))
    email             String              @unique(map: "user_email_key")
    username          String?
    emailVerified     Boolean             @default(false)
    emailVerifiedAt   DateTime?
    name              String?
    status            pg.enum(UserStatus) @default("ACTIVE")
    image             String?
    createdAt         DateTime            @default(now()) @map("created_at")
    updatedAt         DateTime            @onCreate(now()) @onUpdate(now()) @map("updated_at")
    role              pg.enum(Role)       @default("USER")

    sessions                  Session[]
    accounts                  Account[]
    deletedAccountRegistries  DeletedAccountRegistry[] @relation(name: "deleted_account_by", map: "deleted_account_by_userId_fkey")
    restoredAccountRegistries DeletedAccountRegistry[] @relation(name: "deleted_account_restored_by", map: "deleted_account_restored_by_userId_fkey")
    posts                     Post[]
    orders                    Order[]
    cart                      Cart?
    abandonedCarts            AbandonedCart[]
    couponUsages              CouponUsage[]
    wishlist                  Wishlist?
    dashboards                Dashboard[]
    searchAnalytics           SearchAnalytics?
    addresses                 Address[]
    products                  Product[]                 @relation(name: "product_owner")
    productViews              ProductView[]
    reviews                   Review[]
    createdProducts           Product[]                 @relation(name: "product_creator")
    editedProducts            Product[]                 @relation(name: "product_editor")
    publishedProducts         Product[]                 @relation(name: "product_publisher")
    updater                   Stock[]                   @relation(name: "stock_updater")
    stockMovements            StockMovement[]           @relation(name: "stock_movement_user")
    inventoryTransactions     InventoryTransaction[]    @relation(name: "inventory_tx_user")
    variantStockUpdates       VariantStock[]            @relation(name: "variant_stock_updater")
    mediaUploads              Media[]                   @relation(name: "media_uploader")
    idempotencyKeys           IdempotencyKey[]          @relation(name: "idempotency_user")
    userSecurity              UserSecurity?
    userPreferences           UserPreferences?
    userQuota                 UserQuota?
    createdAudits             UserAudit[]               @relation(name: "user_audit_created_by")
    updatedAudits             UserAudit[]               @relation(name: "user_audit_updated_by")
    deletedAudits             UserAudit[]               @relation(name: "user_audit_deleted_by")
    roleAssignment            RoleAssignment?
    twoFactor                 TwoFactor?
    notifications             Notification[]
    productStatusHistories    ProductStatusHistory[]    @relation(name: "product_status_history_user")

    @@rls
    @@map("users")
  }

  model UserSecurity {
    id                  Uuid      @id(map: "user_security_pkey") @onCreate(uuid(7))
    userId              Uuid      @unique(map: "user_security_userId_key")
    twoFactorEnabled    Boolean   @default(false)
    twoFactorSecret     Text?
    adminPinHash        Text?
    passwordChangedAt   DateTime?
    forcePasswordChange Boolean   @default(false)
    blockedAt           DateTime?
    blockedUntil        DateTime?
    blockReason         Text?
    isBlocked           Boolean   @default(false)

    user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_security_userId_fkey")
    backupCodes TwoFactorBackupCode[] @relation(name: "user_security_backup_codes")

    @@rls
    @@map("user_security")
  }

  model UserPreferences {
    id                Uuid                @id(map: "user_preferences_pkey") @onCreate(uuid(7))
    userId            Uuid                @unique(map: "user_preferences_userId_key")
    language          String              @default("fr")
    theme             String              @default("light")
    notifications     Json                @default(json`{}`)
    preferredCurrency pg.enum(Currency)   @default("USD")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_preferences_userId_fkey")

    @@rls
    @@map("user_preferences")
  }

  model UserQuota {
    id           Uuid @id(map: "user_quota_pkey") @onCreate(uuid(7))
    userId       Uuid @unique(map: "user_quota_userId_key")
    productCount Int  @default(0)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_quota_userId_fkey")

    @@rls
    @@map("user_quota")
  }

  model UserAudit {
    id          Uuid     @id(map: "user_audit_pkey") @onCreate(uuid(7))
    userId      Uuid     @unique(map: "user_audit_userId_key")
    deletedAt   DateTime?
    isDeleted   Boolean  @default(false)
    version     Int      @default(1)
    createdById Uuid?
    updatedById Uuid?
    deletedById Uuid?

    user      User  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_audit_userId_fkey")
    createdBy User? @relation(name: "user_audit_created_by", fields: [createdById], references: [id], map: "user_audit_createdById_fkey")
    updatedBy User? @relation(name: "user_audit_updated_by", fields: [updatedById], references: [id], map: "user_audit_updatedById_fkey")
    deletedBy User? @relation(name: "user_audit_deleted_by", fields: [deletedById], references: [id], map: "user_audit_deletedById_fkey")

    @@rls
    @@map("user_audit")
  }

  model Account {
    id                    Uuid      @id(map: "account_pkey") @onCreate(uuid(7))
    userId                Uuid
    type                  String    @default("email")
    providerId            String    @map("provider")
    accountId             String    @map("providerAccountId")
    version               Int       @default(1)
    password              Text?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @onCreate(now()) @onUpdate(now())
    refreshToken          Text?     @map("refresh_token")
    refreshTokenExpiresAt DateTime?
    accessToken           Text?     @map("access_token")
    accessTokenExpiresAt  DateTime?
    expiresAt             DateTime? @map("expires_at")
    tokenType             String?   @map("token_type")
    scope                 String?
    idToken               Text?     @map("id_token")
    sessionState          String?   @map("session_state")

    user              User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_userId_fkey")
    passwordHistories PasswordHistory[] @relation(name: "account_password_histories")

    @@unique([providerId, accountId], map: "account_provider_accountId_key")
    @@index([userId], name: "account_userId_idx")
    @@rls
    @@map("account")
  }

  model PasswordHistory {
    id           Uuid     @id(map: "password_history_pkey") @onCreate(uuid(7))
    accountId    Uuid
    passwordHash Text
    createdAt    DateTime @default(now())
    expiresAt    DateTime?

    account Account @relation(name: "account_password_histories", fields: [accountId], references: [id], onDelete: Cascade, map: "password_history_accountId_fkey")

    @@index([accountId, createdAt], name: "password_history_accountId_createdAt_idx")
    @@rls
    @@map("password_history")
  }

  model PasswordPolicy {
    id               String   @id(map: "password_policy_pkey") @onCreate(uuid(7))
    minLength        Int      @default(12)
    requireUppercase Boolean  @default(true)
    requireLowercase Boolean  @default(true)
    requireNumbers   Boolean  @default(true)
    requireSpecial   Boolean  @default(true)
    maxAge           Int?
    historyCount     Int      @default(5)
    isActive         Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @onCreate(now()) @onUpdate(now())

    @@rls
    @@map("password_policy")
  }

  model Session {
    id        String    @id(map: "session_pkey") @onCreate(uuid(7))
    token     String    @unique(map: "session_token_key")
    userId    Uuid
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @onCreate(now()) @onUpdate(now())
    lastUsedAt DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_userId_fkey")

    @@index([userId], name: "session_userId_idx")
    @@rls
    @@map("session")
  }

  model TwoFactor {
    id          Uuid                @id(map: "twofactor_pkey") @onCreate(uuid(7))
    userId      Uuid                @unique(map: "twofactor_userId_key")
    secret      Text
    enabled     Boolean             @default(false)
    createdAt   DateTime            @default(now())
    updatedAt   DateTime            @onCreate(now()) @onUpdate(now())

    user        User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "twofactor_userId_fkey")
    backupCodes TwoFactorBackupCode[] @relation(name: "twofactor_backup_codes")

    @@rls
    @@map("twofactor")
  }

  model TwoFactorBackupCode {
    id             Uuid       @id(map: "twofactor_backup_code_pkey") @onCreate(uuid(7))
    twoFactorId    Uuid
    userSecurityId Uuid
    used           Boolean    @default(false)
    codeHash       String
    usedAt         DateTime?
    createdAt      DateTime   @default(now())

    twoFactor  TwoFactor    @relation(name: "twofactor_backup_codes", fields: [twoFactorId], references: [id], onDelete: Cascade, map: "twofactor_backup_code_twoFactorId_fkey")
    userSecurity UserSecurity @relation(name: "user_security_backup_codes", fields: [userSecurityId], references: [id], onDelete: Cascade, map: "twofactor_backup_code_userSecurityId_fkey")

    @@index([userSecurityId], name: "twofactor_backup_code_userSecurityId_idx")
    @@rls
    @@map("twofactor_backup_code")
  }

  model TwoFactorAttempt {
    id        Uuid     @id(map: "two_factor_attempt_pkey") @onCreate(uuid(7))
    ipAddress String
    success   Boolean  @default(false)
    createdAt DateTime @default(now())

    @@index([ipAddress, createdAt], name: "two_factor_attempt_ip_createdAt_idx")
    @@rls
    @@map("two_factor_attempt")
  }

  model Verification {
    id           Uuid                   @id(map: "verification_pkey") @onCreate(uuid(7))
    identifier   String
    value        Text
    type         pg.enum(VerificationType)
    attemptCount Int                    @default(0)
    expiresAt    DateTime
    consumedAt   DateTime?
    createdAt    DateTime               @default(now())
    updatedAt    DateTime               @onCreate(now()) @onUpdate(now())

    @@unique([identifier, type, value], map: "verification_identifier_type_value_key")
    @@index([identifier], name: "verification_identifier_idx")
    @@index([expiresAt], name: "verification_expiresAt_idx")
    @@rls
    @@map("verification")
  }

  model LoginAttempt {
    id        Uuid     @id(map: "login_attempt_pkey") @onCreate(uuid(7))
    email     String
    ipAddress String
    success   Boolean  @default(false)
    createdAt DateTime @default(now())

    @@index([ipAddress, createdAt], name: "login_attempt_ip_createdAt_idx")
    @@index([email, createdAt], name: "login_attempt_email_createdAt_idx")
    @@rls
    @@map("login_attempt")
  }

  // ==========================================
  // RBAC (RÃƒâ€LES & PERMISSIONS)
  // ==========================================
  model RoleConfig {
    id              String           @id(map: "role_config_pkey") @onCreate(uuid(7))
    role            pg.enum(Role)    @unique(map: "role_config_role_key")
    level           Int
    parentId        String?
    description     String
    permissions     Json?            @default(json`{}`)
    restrictions    Json?            @default(json`{}`)
    isSystem        Boolean          @default(false)
    isActive        Boolean          @default(true)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @onCreate(now()) @onUpdate(now())
    createdBy       String?
    updatedBy       String?
    blockedAt       DateTime?
    blockedReason   String?
    blockedBy       String?
    unblockedAt     DateTime?
    unblockedBy     String?
    unblockedReason String?

    parent          RoleConfig?      @relation(name: "role_config_hierarchy", fields: [parentId], references: [id], onDelete: SetNull, map: "role_config_parentId_fkey")
    children        RoleConfig[]     @relation(name: "role_config_hierarchy")
    rolePermissions RolePermission[] @relation(name: "role_config_permissions")
    roleAssignments RoleAssignment[] @relation(name: "role_config_assignments")

    @@index([level], name: "role_config_level_idx")
    @@index([isActive], name: "role_config_isActive_idx")
    @@index([isSystem], name: "role_config_isSystem_idx")
    @@rls
    @@map("role_config")
  }

  model RoleAssignment {
    id             Uuid               @id(map: "role_assignment_pkey") @onCreate(uuid(7))
    userId         Uuid               @unique(map: "role_assignment_userId_key")
    roleId         String
    isBlocked      Boolean            @default(false)
    blockedReason  String?
    blockedAt      DateTime?
    blockedUntil   DateTime?
    assignedBy     Uuid?
    assignedAt     DateTime           @default(now())
    lastVerifiedAt DateTime           @default(now())

    user               User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "role_assignment_userId_fkey")
    roleConfig         RoleConfig         @relation(name: "role_config_assignments", fields: [roleId], references: [id], onDelete: Restrict, map: "role_assignment_roleId_fkey")
    permissionOverrides PermissionOverride[] @relation(name: "role_assignment_overrides")

    @@index([roleId], name: "role_assignment_roleId_idx")
    @@index([isBlocked], name: "role_assignment_isBlocked_idx")
    @@rls
    @@map("role_assignment")
  }

  model Permission {
    id          String             @id(map: "permission_pkey") @onCreate(uuid(7))
    code        String             @unique(map: "permission_code_key")
    name        String
    description String?
    category    String
    isDangerous Boolean            @default(false)

    roles     RolePermission[]     @relation(name: "permission_roles")
    overrides PermissionOverride[] @relation(name: "permission_overrides")

    @@rls
    @@map("permission")
  }

  model RolePermission {
    id           Uuid       @id(map: "role_permission_pkey") @onCreate(uuid(7))
    roleconfigId String
    permissionId String

    roleconfig RoleConfig @relation(name: "role_config_permissions", fields: [roleconfigId], references: [id], onDelete: Cascade, map: "role_permission_roleconfigId_fkey")
    permission Permission @relation(name: "permission_roles", fields: [permissionId], references: [id], onDelete: Cascade, map: "role_permission_permissionId_fkey")

    @@unique([roleconfigId, permissionId], map: "role_permission_roleconfigId_permissionId_key")
    @@index([permissionId], name: "role_permission_permissionId_idx")
    @@rls
    @@map("role_permission")
  }

  model PermissionOverride {
    id               Uuid       @id(map: "permission_override_pkey") @onCreate(uuid(7))
    roleAssignmentId Uuid
    permissionId     String
    isGranted        Boolean
    grantedBy        Uuid?
    grantedAt        DateTime   @default(now())
    expiresAt        DateTime?

    roleAssignment RoleAssignment @relation(name: "role_assignment_overrides", fields: [roleAssignmentId], references: [id], onDelete: Cascade, map: "permission_override_roleAssignmentId_fkey")
    permission     Permission     @relation(name: "permission_overrides", fields: [permissionId], references: [id], onDelete: Cascade, map: "permission_override_permissionId_fkey")

    @@unique([roleAssignmentId, permissionId], map: "permission_override_roleAssignmentId_permissionId_key")
    @@rls
    @@map("permission_override")
  }

  // ==========================================
  // PROFIL UTILISATEUR & ADRESSES
  // ==========================================
  model Address {
    id        Uuid     @id(map: "address_pkey") @onCreate(uuid(7))
    userId    Uuid
    label     String?
    street    String
    commune   String
    city      String   @default("Kinshasa")
    country   String   @default("RDC")
    phone     String
    isDefault Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "address_userId_fkey")

    @@index([userId], name: "address_userId_idx")
    @@rls
    @@map("address")
  }

  // ==========================================
  // CATALOGUE & PRODUITS
  // ==========================================
  model Catalog {
    id         Uuid             @id(map: "catalog_pkey") @onCreate(uuid(7))
    name       String
    imageSrc   String?
    imageAlt   String
    isActive   Boolean          @default(true)
    categoryId Uuid?

    products CatalogProduct[] @relation(name: "catalog_products")
    category Category?        @relation(name: "catalog_category", fields: [categoryId], references: [id], map: "catalog_categoryId_fkey")

    @@rls
    @@map("catalog")
  }

  model Category {
    id                 Uuid           @id(map: "category_pkey") @onCreate(uuid(7))
    name               String           @unique(map: "category_name_key")
    slug               String           @unique(map: "category_slug_key")
    description        Text?
    subtitle           String
    image              String?
    isNavigable        Boolean          @default(true)
    managedByRoles     String[]         @default([])
    requiredPermission String           @default("products:read")
    minRoleLevel       Int              @default(6)
    displayOrder       Int              @default(0)
    OrderBy            String
    parentId           Uuid?
    seoTitle           String?
    seoDescription     String?
    deletedAt          DateTime?
    createdAt          DateTime         @default(now())
    updatedAt          DateTime         @onCreate(now()) @onUpdate(now())

    parent           Category?          @relation(name: "category_hierarchy", fields: [parentId], references: [id], map: "category_parentId_fkey")
    children         Category[]        @relation(name: "category_hierarchy")
    categoryProducts CategoryProduct[] @relation(name: "category_products")
    products         Product[]         @relation(name: "product_categories")
    catalogs         Catalog[]         @relation(name: "catalog_category")

    @@index([parentId], name: "category_parentId_idx")
    @@rls
    @@map("category")
  }

  model CategoryProduct {
    productId    String
    categoryId   Uuid
    displayOrder Int @default(0)

    product  Product  @relation(name: "product_category_products", fields: [productId], references: [id], onDelete: Cascade, map: "category_product_productId_fkey")
    category Category @relation(name: "category_products", fields: [categoryId], references: [id], onDelete: Cascade, map: "category_product_categoryId_fkey")

    @@id([productId, categoryId], map: "category_product_pkey")
    @@index([categoryId], name: "category_product_categoryId_idx")
    @@rls
    @@map("category_product")
  }

  model CatalogProduct {
    catalogId     Uuid
    productId     String
    priceOverride Decimal(precision: 10, scale: 2)?
    isActive      Boolean  @default(true)

    catalog Catalog @relation(name: "catalog_products", fields: [catalogId], references: [id], onDelete: Cascade, map: "catalog_product_catalogId_fkey")
    product Product @relation(name: "product_catalogs", fields: [productId], references: [id], onDelete: Cascade, map: "catalog_product_productId_fkey")

    @@id([catalogId, productId], map: "catalog_product_pkey")
    @@index([productId], name: "catalog_product_productId_idx")
    @@rls
    @@map("catalog_product")
  }

  model Product {
    id              String                 @id(map: "product_pkey") @onCreate(uuid(7))
    name            String
    sku             String                 @unique(map: "product_sku_key")
    slug            String                 @unique(map: "product_slug_key")
    description     Text
    currency        pg.enum(Currency)      @default("USD")
    productTypeId   String
    categoryId      Uuid?
    userId          Uuid
    images          String[]
    videoUrl        String?
    isFeatured      Boolean                @default(false)
    isArchived      Boolean                @default(false)
    isActive        Boolean                @default(false)
    isdeleted       Boolean                @default(false)
    deletedAt       DateTime?
    status          pg.enum(ProductStatus) @default("DRAFT")
    scheduledAt     DateTime?
    publishedAt     DateTime?
    seoTitle        String?
    seoDescription  Text?
    taxClassId      String?
    saleStart       DateTime?
    saleEnd         DateTime?
    soldCount       Int                    @default(0)
    createdBy       Uuid?
    updatedBy       Uuid?
    publishedById   Uuid?
    createdAt       DateTime               @default(now())
    updatedAt       DateTime               @onCreate(now()) @onUpdate(now())
    couponId        String?

    productType        ProductTypeConfig         @relation(name: "product_type_products", fields: [productTypeId], references: [id], onDelete: Restrict, map: "product_productTypeId_fkey")
    category           Category?                 @relation(name: "product_categories", fields: [categoryId], references: [id], map: "product_categoryId_fkey")
    user               User                      @relation(name: "product_owner", fields: [userId], references: [id], map: "product_userId_fkey")
    catalogs           CatalogProduct[]          @relation(name: "product_catalogs")
    creator            User?                     @relation(name: "product_creator", fields: [createdBy], references: [id], map: "product_createdBy_fkey")
    editor             User?                     @relation(name: "product_editor", fields: [updatedBy], references: [id], map: "product_updatedBy_fkey")
    publisher          User?                     @relation(name: "product_publisher", fields: [publishedById], references: [id], map: "product_publishedById_fkey")
    taxClass           TaxClass?                 @relation(name: "product_tax_classes", fields: [taxClassId], references: [id], map: "product_taxClassId_fkey")
    statusHistory      ProductStatusHistory[]    @relation(name: "product_status_history")
    variants           ProductVariant[]          @relation(name: "product_variants")
    wishlistItems      WishlistItem[]            @relation(name: "wishlist_items")
    productImages      ProductImage[]            @relation(name: "product_images")
    productTags        ProductTag[]              @relation(name: "product_tags")
    attributeValues    ProductAttributeValue[]   @relation(name: "product_attribute_values")
    productReviews     Review[]                  @relation(name: "product_reviews")
    inventoryLedger    InventoryTransaction[]    @relation(name: "inventory_ledger")
    inventorySnapshots InventorySnapshot[]       @relation(name: "inventory_snapshots")
    availabilityProjection Product_Availability_Projection? @relation(name: "product_availability")
    stock              Stock?                    @relation(name: "product_stock")
    coupon             Coupon?                   @relation(name: "coupon_products", fields: [couponId], references: [id], map: "product_couponId_fkey")
    productViews       ProductView[]             @relation(name: "product_views")
    categoryProducts   CategoryProduct[]         @relation(name: "product_category_products")
    orderItems         OrderItem[]               @relation(name: "order_items")

    @@index([createdBy], name: "product_createdBy_idx")
    @@index([updatedBy], name: "product_updatedBy_idx")
    @@index([publishedById], name: "product_publishedById_idx")
    @@index([status, scheduledAt], name: "product_status_scheduledAt_idx")
    @@index([productTypeId], name: "product_productTypeId_idx")
    @@index([status, isActive], name: "product_status_isActive_idx")
    @@index([categoryId], name: "product_categoryId_idx")
    @@index([createdAt], name: "product_createdAt_idx")
    @@index([isArchived, isdeleted, status], name: "product_admin_filters_idx")
    @@rls
    @@map("product")
  }

  model ProductStatusHistory {
    id          Uuid                   @id(map: "product_status_history_pkey") @onCreate(uuid(7))
    productId   String
    oldStatus   pg.enum(ProductStatus)
    newStatus   pg.enum(ProductStatus)
    reason      Text?
    changedById Uuid?
    changedAt   DateTime               @default(now())

    product Product @relation(name: "product_status_history", fields: [productId], references: [id], onDelete: Cascade, map: "product_status_history_productId_fkey")
    changedBy User? @relation(name: "product_status_history_user", fields: [changedById], references: [id], onDelete: SetNull, map: "product_status_history_changedById_fkey")

    @@index([productId, changedAt], name: "product_status_history_productId_changedAt_idx")
    @@rls
    @@map("product_status_history")
  }

  model ProductVariant {
    id          Uuid     @id(map: "product_variant_pkey") @onCreate(uuid(7))
    productId   String
    sku         String   @unique(map: "product_variant_sku_key")
    attributes  Json     @default(json`{}`)
    priceOffset Int      @default(0)
    createdAt   DateTime @default(now())
    isActive    Boolean  @default(true)

    product               Product                @relation(name: "product_variants", fields: [productId], references: [id], onDelete: Cascade, map: "product_variant_productId_fkey")
    orderItems            OrderItem[]            @relation(name: "order_item_variants")
    cartItems             CartItem[]             @relation(name: "cart_items")
    inventoryTransactions InventoryTransaction[] @relation(name: "variant_inventory_tx")
    inventorySnapshots    InventorySnapshot[]    @relation(name: "variant_inventory_snapshots")
