    userId             Uuid
    rating             Int2
    comment            Text?
    isVerifiedPurchase Boolean  @default(false)
    createdAt          DateTime @default(now())
    updatedAt          DateTime @onCreate(now()) @onUpdate(now())

    product Product @relation(name: "product_reviews", fields: [productId], references: [id], onDelete: Cascade, map: "review_productId_fkey")
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "review_userId_fkey")

    @@unique([productId, userId], map: "review_productId_userId_key")
    @@index([productId, rating], name: "review_productId_rating_idx")
    @@rls
