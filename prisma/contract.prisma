    expiresAt DateTime
    createdAt DateTime       @default(now())

    order   Order          @relation(name: "order_stock_reservations", fields: [orderId], references: [id], onDelete: Cascade, map: "stock_reservation_orderId_fkey")
    variant ProductVariant @relation(name: "variant_stock_reservations", fields: [variantId], references: [id], onDelete: Cascade, map: "stock_reservation_variantId_fkey")

    @@index([expiresAt], name: "stock_reservation_expiresAt_idx")
