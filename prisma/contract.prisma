    isAvailable Boolean  @default(false)
    updatedAt   DateTime @onCreate(now()) @onUpdate(now())

    product Product @relation(name: "product_availability", fields: [productId], references: [id], onDelete: Cascade, map: "product_availability_projection_productId_fkey")

    @@rls
    @@map("product_availability_projection")
  }

  model ProductPrice {
