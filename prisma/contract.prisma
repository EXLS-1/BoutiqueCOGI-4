    minRoleLevel         Int
    isTerminal           Boolean              @default(false)
    triggersNotification Boolean              @default(true)
    createdAt            DateTime             @default(now())
    updatedAt            DateTime             @onCreate(now()) @onUpdate(now())

    histories OrderStatusHistory[] @relation(name: "order_status_histories_ref")

    @@rls
    @@map("order_status")
